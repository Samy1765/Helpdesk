# ==============================================
# PRECISION AI - environment configuration
# Copy to .env (Docker) or backend/.env (local dev). NEVER commit real values.
# Comments are on their own lines (docker compose env_file does not reliably strip inline comments).
# Every setting the backend reads is listed here; commented lines show the default.
# ==============================================

# ---- Application ----
# development | test | production. Anything other than development/test refuses to start with a
# placeholder or short SECRET_KEY, or with a wildcard CORS origin.
APP_ENV=development
APP_PORT=8000
# APP_NAME=PrecisionAI
# APP_HOST=0.0.0.0
# APP_DEBUG=false
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-64-char-random-string

# ---- Frontend ----
# Only needed when the UI is served from a different origin than the API (Vite dev server).
# Exact origins only; the app is normally served from the same origin as the API.
CORS_ORIGINS=["http://localhost:5173","http://localhost:8000"]
# FRONTEND_URL=http://localhost:5173
# Serve the built React app (frontend/dist) from FastAPI
# SERVE_FRONTEND=true
# FRONTEND_DIST_DIR=../frontend/dist

# ---- Sign-in, sessions and request limits ----
# JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
# Lock a username/email after this many failed sign-ins within LOGIN_LOCKOUT_MINUTES (unknown names too)
LOGIN_MAX_FAILURES=5
LOGIN_LOCKOUT_MINUTES=15
# Failed sign-ins per client IP per 15 minutes, self-registrations per IP per hour, chat messages per user per minute
RATE_LIMIT_LOGIN_FAILURES_PER_IP=30
RATE_LIMIT_REGISTER_PER_HOUR=10
RATE_LIMIT_CHAT_PER_MINUTE=20
# Set to false when accounts are created by IT only
ALLOW_SELF_REGISTRATION=true
# Largest JSON request body in KB (uploads are limited by MAX_UPLOAD_MB)
MAX_REQUEST_KB=1024
# Swagger UI / ReDoc / OpenAPI schema. Blank = on everywhere except APP_ENV=production. /docs loads its
# JavaScript from a CDN, so it needs internet; the application itself does not.
API_DOCS_ENABLED=
# Docker only: reverse-proxy address(es) whose X-Forwarded-For / X-Forwarded-Proto headers are trusted
FORWARDED_ALLOW_IPS=127.0.0.1

# ---- Seed data ----
# true: load the fictional demo company (Acme Demo Industries: about 60 employees, a quarter of tickets,
# incidents, approvals, feedback). false: production bootstrap (roles, teams, categories, knowledge base only).
SEED_DEMO_DATA=true
# Production bootstrap only (python -m app.scripts.bootstrap): first administrator account
# BOOTSTRAP_ADMIN_USERNAME=it.admin
# BOOTSTRAP_ADMIN_EMAIL=it.admin@yourcompany.com
# BOOTSTRAP_ADMIN_NAME=IT Administrator
# BOOTSTRAP_ADMIN_PASSWORD=

# ---- Database ----
# Docker Compose builds DATABASE_URL from these three values
POSTGRES_DB=precision_ai
POSTGRES_USER=precision_user
POSTGRES_PASSWORD=precision_pass
# Local dev without Docker - PostgreSQL:
# DATABASE_URL=postgresql+asyncpg://precision_user:precision_pass@localhost:5432/precision_ai
# ...or SQLite:
# DATABASE_URL=sqlite+aiosqlite:///./precision_ai.db
# Log every SQL statement
# DB_ECHO=false

# ---- LLM tiers (optional: without any model the system runs deterministically and offline) ----
# Providers: ollama | groq | openai | gemini | none
# Level 4 - cheap/local model: extraction and simple troubleshooting
LLM_SMALL_PROVIDER=ollama
# Level 5 - capable model: retries and ambiguous cases only
LLM_LARGE_PROVIDER=groq
# Leave the tier models blank to use each provider's default model below
# (e.g. LLM_SMALL_PROVIDER=groq + LLM_SMALL_MODEL=openai/gpt-oss-20b for a cheaper cloud small tier)
LLM_SMALL_MODEL=
LLM_LARGE_MODEL=

# Ollama (local, free, no key): install from https://ollama.com, then `ollama pull llama3.2`
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
# Groq: create a key at https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# OpenAI: https://platform.openai.com/api-keys (needs billing enabled)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Gemini: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=2
# Responses cached in memory (identical prompt -> no second paid call)
# LLM_CACHE_SIZE=512
# Reasoning models (gpt-oss, gpt-5, Gemini 2.5+/3): low | medium | high, plus token headroom for thinking
LLM_REASONING_EFFORT=low
LLM_REASONING_EXTRA_TOKENS=1024
# Used only to estimate savings on the admin dashboard (large model, USD per 1K tokens)
LLM_REFERENCE_COST_PER_1K=0.00024
LLM_ESTIMATED_TOKENS_PER_CALL=1200

# ---- Embeddings & FAISS ----
# sentence-transformers (semantic) | hashing (dependency-free lexical fallback)
EMBEDDING_BACKEND=sentence-transformers
EMBEDDING_MODEL=all-MiniLM-L6-v2
FAISS_INDEX_DIR=./faiss_indexes
DUPLICATE_SIMILARITY_THRESHOLD=0.75
SOLUTION_REUSE_THRESHOLD=0.62
RELATED_SIMILARITY_THRESHOLD=0.45
KB_RELEVANCE_THRESHOLD=0.40
CROSS_CATEGORY_SIMILARITY=0.85

# ---- Incident correlation ----
INCIDENT_WINDOW_MINUTES=60
INCIDENT_MIN_TICKETS=3
INCIDENT_SIMILARITY_THRESHOLD=0.55

# ---- Agent ----
AGENT_MAX_ATTEMPTS=2
# SAFE read-only diagnostics against SERVICE_CATALOG_FILE. The sample catalogue probes public internet
# hosts, so this stays off until the catalogue lists your own internal endpoints.
AGENT_TOOLS_ENABLED=false
# SERVICE_CATALOG_FILE=../data/service_catalog.json
SLA_MINUTES={"critical": 60, "high": 240, "medium": 480, "low": 1440}

# ---- Attachments ----
MAX_UPLOAD_MB=5
# UPLOAD_DIR=../data/uploads

# ---- Logging ----
LOG_LEVEL=INFO
# json | console
LOG_FORMAT=json
