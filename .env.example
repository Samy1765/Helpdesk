# ==============================================
# PRECISION AI - environment configuration
# Copy to .env (Docker) or backend/.env (local dev). NEVER commit real values.
# Comments are on their own lines (docker compose env_file does not reliably strip inline comments).
# ==============================================

# ---- Application ----
# development | production (production refuses the default SECRET_KEY)
APP_ENV=development
APP_PORT=8000
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-64-char-random-string
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
CORS_ORIGINS=["http://localhost:5173","http://localhost:8000"]
# Docker only: load synthetic demo data on first start
SEED_DEMO_DATA=true

# ---- Database ----
# Docker Compose builds DATABASE_URL from these three values
POSTGRES_DB=precision_ai
POSTGRES_USER=precision_user
POSTGRES_PASSWORD=precision_pass
# Local dev without Docker - PostgreSQL:
# DATABASE_URL=postgresql+asyncpg://precision_user:precision_pass@localhost:5432/precision_ai
# ...or SQLite:
# DATABASE_URL=sqlite+aiosqlite:///./precision_ai.db

# ---- LLM tiers (optional: without any model the system runs deterministically) ----
# Providers: ollama | groq | openai | gemini | none
# Level 4 - cheap/local model: extraction and simple troubleshooting
LLM_SMALL_PROVIDER=ollama
# Level 5 - capable model: retries and ambiguous cases only
LLM_LARGE_PROVIDER=groq
# Leave the tier models blank to use each provider's default model below
# (e.g. LLM_SMALL_PROVIDER=groq + LLM_SMALL_MODEL=openai/gpt-oss-20b for a cheaper cloud small tier)
LLM_SMALL_MODEL=
LLM_LARGE_MODEL=

# Ollama (local, free, no key): install from https://ollama.com, then `ollama pull llama3.2`
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
# Groq: create a key at https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# OpenAI: https://platform.openai.com/api-keys (needs billing enabled)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Gemini: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=2
# Reasoning models (gpt-oss, gpt-5, Gemini 2.5+/3): low | medium | high, plus token headroom for thinking
LLM_REASONING_EFFORT=low
LLM_REASONING_EXTRA_TOKENS=1024
# Used only to estimate savings on the admin dashboard (large model, USD per 1K tokens)
LLM_REFERENCE_COST_PER_1K=0.00024
LLM_ESTIMATED_TOKENS_PER_CALL=1200

# ---- Embeddings & FAISS ----
# sentence-transformers (semantic) | hashing (dependency-free lexical fallback)
EMBEDDING_BACKEND=sentence-transformers
EMBEDDING_MODEL=all-MiniLM-L6-v2
FAISS_INDEX_DIR=./faiss_indexes
DUPLICATE_SIMILARITY_THRESHOLD=0.75
SOLUTION_REUSE_THRESHOLD=0.62
RELATED_SIMILARITY_THRESHOLD=0.45
KB_RELEVANCE_THRESHOLD=0.40
CROSS_CATEGORY_SIMILARITY=0.85

# ---- Incident correlation ----
INCIDENT_WINDOW_MINUTES=60
INCIDENT_MIN_TICKETS=3
INCIDENT_SIMILARITY_THRESHOLD=0.55

# ---- Agent ----
AGENT_MAX_ATTEMPTS=2
# SAFE read-only diagnostics against data/service_catalog.json
AGENT_TOOLS_ENABLED=true
SLA_MINUTES={"critical": 60, "high": 240, "medium": 480, "low": 1440}
MAX_UPLOAD_MB=5

# ---- Logging ----
LOG_LEVEL=INFO
# json | console
LOG_FORMAT=json
